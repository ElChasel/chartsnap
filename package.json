{
  "name": "chartsnap",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --config vite.frontend.config.js",
    "test:e2e": "playwright test",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "dev:static": "vite --config vite.frontend.config.js --host 127.0.0.1",
    "build:static": "node scripts/build-static.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "drizzle-orm": "0.45.2",
    "echarts": "6.1.0",
    "lucide-react": "0.468.0",
    "next": "16.4.2",
    "papaparse": "5.5.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261022.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "drizzle-kit": "0.31.11",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.3.1",
    "typescript": "5.9.3",
    "vinext": "1.3.0",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "wrangler": "4.151.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.1"
    },
    "fflate": "0.8.3"
  }
}
